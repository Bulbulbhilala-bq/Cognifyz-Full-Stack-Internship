<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registration Success</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="min-h-screen bg-slate-100 flex items-center justify-center p-6">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-xl p-8">
        <h1 class="text-3xl font-bold text-green-600 text-center mb-4">
            Registration Successful!</h1>
        <h2 class="text-xl font-semibold text-gray-800 mb-5">
            Student Information
        </h2>
        <p class="text-gray-600 mb-3">
            Name: <%= name %>
        </p>
        <p class="text-gray-600">
            Email: <%= email %>
        </p>
        <p class="text-gray-600">
            Total Students Registered: <%= totalStudents %>
        </p>
        <a href="/" class="block text-center mt-6 bg-blue-600 text-white py-3 rounded-lg hover:bg-blue-700 transition">
            Back to Home
        </a>
    </div>
</body>
</html>